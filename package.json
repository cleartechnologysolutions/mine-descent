{
  "name": "mine-descent",
  "version": "4.0.2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve-local.mjs",
    "build": "node scripts/assemble.mjs",
    "validate": "node scripts/validate.mjs",
    "dev": "npx wrangler dev",
    "deploy": "npm run build && npx wrangler deploy --config wrangler.jsonc",
    "test:audio": "node tests/audio.cjs",
    "test:mechanics": "node tests/mechanics.mjs",
    "test:multiplayer": "node tests/multiplayer.mjs",
    "test:sockets": "node tests/sockets.mjs",
    "test:rate-limit": "node tests/rate-limit.mjs",
    "test:effects": "node tests/multiplayer-effects.mjs"
  }
}
